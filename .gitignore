# =============================================================================
# PneumoAI .gitignore
# =============================================================================

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Python & Cache Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# --- Node / Frontend Build & Dependencies ---
frontend/node_modules/
node_modules/
frontend/dist/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Large Model Checkpoints (> 50 MB / 100 MB GitHub Limit) ---
# The trained EfficientNetV2-S checkpoint (~243 MB) exceeds GitHub's 100 MB hard limit.
# Recommended: Host via GitHub Releases asset or Git LFS.
*.pth
*.pt
*.onnx
*.bin
*.h5
*.ckpt
efficientnetv2_s_best.pth

# --- Submission & Distribution Archives ---
*.zip
*.tar.gz
*.rar
*.7z
PneumoAI_Source_Code.zip

# --- Environment & Secret Files ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# --- Logs & Temporary Files ---
*.log
*.tmp
*.bak
*.swp
*~
temp/
tmp/

# --- Datasets & Demo Raw Media ---
data/
dataset/
datasets/
raw_images/
*.dcm

# --- Operating System & IDE Specific Files ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
